# Copy this file to .env and fill in the values. .env is never committed.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# PostgreSQL connection string (from Neon: Dashboard -> Connect).
# Leave it commented out to use a local SQLite file (no setup needed).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Help chatbot: free API key from https://aistudio.google.com/apikey (leave empty to disable)
GEMINI_API_KEY=

# Real activation emails through Gmail (leave empty to print emails in the terminal).
# EMAIL_HOST_PASSWORD is a 16-character App Password: https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
