# Copy this file to .env and fill in the values. .env is never committed.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# PostgreSQL connection string (from Neon: Dashboard -> Connect).
# Leave it out to use a local SQLite file instead.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Help chatbot: API key from https://console.anthropic.com (leave empty to disable)
ANTHROPIC_API_KEY=
