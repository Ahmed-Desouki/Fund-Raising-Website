# Copy this file to .env and fill in the values. .env is never committed.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# PostgreSQL connection string (from Neon: Dashboard -> Connect).
# Leave it commented out to use a local SQLite file (no setup needed).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Help chatbot: free API key from https://aistudio.google.com/apikey (leave empty to disable)
GEMINI_API_KEY=

# Real emails to people who register (leave empty to print emails in the terminal).
# Gmail: EMAIL_HOST_PASSWORD is a 16-letter App Password from https://myaccount.google.com/apppasswords
# Check with: python manage.py send_test_email you@example.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Only for services other than Gmail:
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_FROM=noreply@yourdomain.com
